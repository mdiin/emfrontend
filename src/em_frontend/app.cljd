(ns em-frontend.app
  "spec: ties together every other namespace into the running app --
   em-frontend.store's reactive state, em-frontend.stream's SSE ingestion,
   em-frontend.canvas's per-timeline painting and hit-testing,
   em-frontend.interaction's viewport/trace/filter rules, and the six
   read-only panels.

   Gesture-driven pan/zoom (InteractiveViewer's onInteraction* callbacks)
   and tap-hit-test offsets are written from the Flutter API contract but
   unverified against a live gesture/device -- check these first against a
   running app.

   `stream-url` defaults to emcli's own default `emcli serve` address
   (../thecli/src/emcli/cli.clj's `default-server`); there's no real
   config/CLI surface here yet to override it, since the spec doesn't cover
   deployment configuration."
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/gestures.dart" :as g]
            ["dart:math" :as math]
            [cljd.flutter :as f]
            [em-frontend.config :as config]
            [em-frontend.model :as model]
            [em-frontend.store :as store]
            [em-frontend.stream :as stream]
            [em-frontend.interaction :as interaction]
            [em-frontend.canvas :as canvas]
            [em-frontend.panels.element-details :as p.element-details]
            [em-frontend.panels.connection-details :as p.connection-details]
            [em-frontend.panels.incomplete-tooltip :as p.incomplete-tooltip]
            [em-frontend.panels.specification-expanded :as p.specification-expanded]
            [em-frontend.panels.timeline-filter :as p.timeline-filter]
            [em-frontend.panels.field-flow-trace :as p.field-flow-trace]))

(def stream-url "http://localhost:8090/stream")

(def ^:private ^m/GlobalKey viewport-key (f/global-key ::viewport))

(defn- apply-outcome!
  "Applies a {:store :effects} rule result: swaps the domain store, and
   folds ConnectionHighlighted/ConnectionDimmed effects into ui-atom's
   transient connection-visual map (em-frontend.canvas's edge styling) --
   the one piece of render-relevant state the spec models purely as
   one-shot effects rather than stored fields (see em-frontend.interaction's
   select-field-for-trace docstring). InvalidDataIndicatorShown is folded in
   the same way, into :invalid-data, so rule InvalidDataVisible's payload is
   surfaced rather than silently dropped. ErrorOverlayShown is folded in as
   :failed-connection, and cleared again by the next :store-seeded -- a
   successful recovery is exactly a reseed from a fresh snapshot.

   Animation effects (ElementAppears/ElementDisappears, TimelineAppears/
   TimelineDisappears) seed the alpha/opacity maps in ui-atom; the shared
   ticker (root widget) drives element alphas toward their targets each frame,
   and AnimatedOpacity handles timeline fades implicitly."
  [store-atom ui-atom {:keys [store effects]}]
  (reset! store-atom store)
  (doseq [fx effects]
    (case (:type fx)
      :connection-highlighted (swap! ui-atom assoc-in [:connection-visual (:connection fx)] :highlighted)
      :connection-dimmed (swap! ui-atom assoc-in [:connection-visual (:connection fx)] :dimmed)
      :field-flow-trace-cleared (swap! ui-atom assoc :connection-visual {})
      :invalid-data-indicator-shown (swap! ui-atom assoc :invalid-data (:delta fx))
      :error-overlay-shown (swap! ui-atom assoc :failed-connection (:connection fx))
      :element-appears
        (let [eid (:id (:element fx))]
          (swap! ui-atom
                 (fn [ui]
                   (-> ui
                       (assoc-in [:element-target-alphas eid] 1.0)
                       (update :element-current-alphas
                               (fn [m] (if (contains? m eid) m (assoc m eid 0.0))))))))
      :element-disappears
        (let [eid (:id (:element fx))]
          (swap! ui-atom
                 (fn [ui]
                   (-> ui
                       (assoc-in [:element-target-alphas eid] 0.0)
                       (update :element-current-alphas
                               (fn [m] (if (contains? m eid) m (assoc m eid 1.0))))))))
      :timeline-appears
        (swap! ui-atom assoc-in [:timeline-target-opacities (:timeline fx)] 1.0)
      :timeline-disappears
        (swap! ui-atom (fn [ui]
                         (-> ui
                             (update :fading-out-timelines conj (:timeline fx))
                             (assoc-in [:timeline-target-opacities (:timeline fx)] 0.0))))
      :store-seeded
        (swap! ui-atom assoc
               :element-target-alphas {}
               :element-current-alphas {}
               :fading-out-timelines #{}
               :timeline-target-opacities {}
               ;; a successful reconnect/retry reseeds from a fresh snapshot,
               ;; so there is no failed connection left to report
               :failed-connection nil)
      nil)))

;; == Starting (and restarting) the stream ====================================

(defn- start-stream!
  "Starts the SSE driver, wiring stream/connect!'s four callbacks onto
   store-atom/ui-atom through apply-outcome!. Hoisted out of `root` so the
   same wiring can be invoked again for a manual retry or reload: connect!
   builds its own http Client and Completer per call, so a second call is an
   independent driver, not a resumption of the failed one. Returns that
   driver's handle, so a caller can retire it (stream/disconnect!) before
   starting the next one -- two live drivers would both write the atoms.

   `initial-state` is the state the fresh driver announces for its first
   attempt, and every caller passes the very state its rule ensures --
   :connecting for the cold start and for a retry (RetryRestartsConnection),
   :reconnecting for a reload (ReloadRestartsConnection) -- so the driver
   never writes an undeclared SSEConnection edge such as
   `reconnecting -> connecting`."
  [store-atom ui-atom initial-state]
  (stream/connect! stream-url initial-state
    (fn [s] (apply-outcome! store-atom ui-atom (store/set-sse-state @store-atom s)))
    (fn [seed] (apply-outcome! store-atom ui-atom (store/snapshot-received @store-atom seed)))
    (fn [changes] (apply-outcome! store-atom ui-atom (store/ingest-delta @store-atom changes)))
    (fn [raw] (apply-outcome! store-atom ui-atom (store/invalid-delta-received @store-atom raw)))))

(defn- retry-stream!
  "rule RetryRestartsConnection, driven by the error banner's Retry button:
   retire the current driver, apply the pure retry action, then start the
   stream again -- but only when the connection really was :error. The retry
   moves it straight to :connecting, so a second invocation (or a double
   click) sees :connecting and starts nothing: at most one connection attempt
   is ever in flight.

   The handle is threaded in and recorded exactly as in `reload-model!`, so
   `stream-handle` always names the live driver. Retiring first is a no-op on
   the driver that just ended on :error (`disconnect!` is nil-safe and
   idempotent), but it is what stops a still-live driver from being orphaned:
   without it, a retry followed by a reload would cancel the DEAD handle and
   leave this fresh one delivering snapshots and deltas into the same atoms
   alongside the reload's replacement (double reseed, every delta applied
   twice)."
  [store-atom ui-atom stream-handle]
  (when (= :error (get-in @store-atom [:sse-connection :state]))
    (stream/disconnect! @stream-handle)
    (apply-outcome! store-atom ui-atom (store/retry-stream @store-atom))
    (reset! stream-handle (start-stream! store-atom ui-atom :connecting))))

(defn- reload-model!
  "rule ReloadRestartsConnection, driven by the app bar's Reload model
   button: retire the live driver (so only one ever writes the atoms), apply
   the pure reload action, then start a fresh driver whose full snapshot
   reseeds the store through the existing SnapshotReceived path
   (ReconnectPreservesViewport). No view state is touched anywhere here --
   reload refreshes the model, not the view. The pure rule's :connected
   guard is also the single-in-flight guard: the reload moves the connection
   to :reconnecting, so a second invocation (or a double click) sees that
   and neither cancels nor starts anything.

   The fresh driver announces :reconnecting for its first attempt -- the
   very state the rule ensures -- so the reload's observable sequence is
   `connected -> reconnecting -> connected` and no undeclared
   `reconnecting -> connecting` edge is ever written."
  [store-atom ui-atom stream-handle]
  (when (= :connected (get-in @store-atom [:sse-connection :state]))
    (stream/disconnect! @stream-handle)
    (apply-outcome! store-atom ui-atom (store/reload-model @store-atom))
    (reset! stream-handle (start-stream! store-atom ui-atom :reconnecting))))

;; == Canvas: per-timeline hit-testing + the whole-canvas InteractiveViewer ===

(defn- timeline-widget [st ui store-atom ui-atom timeline-id]
  (let [zoom         (double (get-in st [:visualization :zoom] 1.0))
        title        (get-in st [:timelines timeline-id :title])
        render-model (canvas/build-timeline-render-model st timeline-id)
        painter      (canvas/timeline-painter (assoc render-model
                                                     :connection-visual (:connection-visual ui)
                                                     :element-alphas (:element-current-alphas ui)
                                                     :title title
                                                     :zoom zoom))
        layout-size  (get-in render-model [:layout :size])
        title-h      (canvas/timeline-title-height zoom)
        total-size   {:width (:width layout-size) :height (+ (:height layout-size) title-h)}
        ;; hit-test coordinates are widget-local; the table is translated down
        ;; by title-h inside the painter, so adjust the tap/hover y accordingly.
        adjust-pt    (fn [^m/Offset pt] (m/Offset (.-dx pt) (- (.-dy pt) title-h)))]
    (m/GestureDetector
      .onTapUp
      (fn [^m/TapUpDetails details]
        (let [pt     (adjust-pt (.-localPosition details))
              layout (:layout render-model)]
          (cond
            (some? (canvas/hit-test-placement layout pt))
            (swap! ui-atom assoc :selected-element (canvas/hit-test-placement layout pt)
                                  :selected-connection nil)

            (some? (canvas/hit-test-edge (:edges render-model) pt 6.0))
            (swap! ui-atom assoc :selected-connection (canvas/hit-test-edge (:edges render-model) pt 6.0)
                                  :selected-element nil)

            (some? (canvas/hit-test-slice-header layout pt))
            (swap! ui-atom update :expanded-slices
                   (fn [s] (if (contains? s (canvas/hit-test-slice-header layout pt))
                             (disj s (canvas/hit-test-slice-header layout pt))
                             (conj s (canvas/hit-test-slice-header layout pt)))))))
        nil)
      .child
      (m/MouseRegion
        .onHover
        (fn [^g/PointerHoverEvent e]
          (let [eid (canvas/hit-test-placement (:layout render-model) (adjust-pt (.-localPosition e)))]
            (swap! ui-atom assoc :hovered-element eid))
          nil)
        .onExit (fn [_] (swap! ui-atom assoc :hovered-element nil) nil)
        .child
        (m/CustomPaint .size (m/Size (:width total-size) (:height total-size)) .painter painter)))))

(defn- clamp [v lo hi] (max lo (min hi v)))

(defn- apply-wheel-zoom!
  "Mouse-wheel zoom, centred on the pointer: scales `transform-controller`'s
   matrix around the event's local position, clamped to config's zoom bounds."
  [^m/TransformationController transform-controller store-atom ^double scroll-dy ^m/Offset local]
  (let [cur-scale (.getMaxScaleOnAxis (.-value transform-controller))
        raw-factor (math/pow 1.0015 (- scroll-dy))
        factor (clamp raw-factor (/ config/min-zoom cur-scale) (/ config/max-zoom cur-scale))]
    (when (not= factor 1.0)
      (let [mat (.clone (.-value transform-controller))]
        (.translate mat (.-dx local) (.-dy local))
        (.scale mat ^double factor)
        (.translate mat (- (.-dx local)) (- (.-dy local)))
        (.-value! transform-controller mat))
      (swap! store-atom #(:store (interaction/zoom % factor))))))

(defn- content-extent
  "Total laid-out size of the WHOLE model -- every timeline, filter or not,
   matching canvas-body's unfiltered Column: stacked, so height sums and
   width is the widest one. Feeds interaction/snap-to-content's
   content-width/height (rule ViewportSnapsToContent's content_fit_zoom/
   content_center_pan_x/content_center_pan_y)."
  [st]
  (let [zoom         (double (get-in st [:visualization :zoom] 1.0))
        timeline-ids (keys (:timelines st))
        n            (count timeline-ids)
        {:keys [width height]}
        (reduce
          (fn [{:keys [width height]} timeline-id]
            (let [size (get-in (canvas/build-timeline-render-model st timeline-id) [:layout :size])]
              {:width  (max width (:width size))
               :height (+ height (:height size) (canvas/timeline-title-height zoom))}))
          {:width 0.0 :height 0.0}
          timeline-ids)]
    {:width width
     :height (+ height (* (dec n) (canvas/timeline-gap zoom)))}))

(defn- snap-to-content!
  "Fits + centers the whole model in the viewport (rule
   ViewportSnapsToContent): measures the laid-out content extent and the
   InteractiveViewer's own rendered size, hands both to the pure store
   transform, then drives transform-controller directly since it -- not the
   mirrored store fields -- is what actually renders the pan/zoom."
  [store-atom ui-atom ^m/TransformationController transform-controller]
  (let [st @store-atom
        {:keys [width height]} (content-extent st)
        ^m/Element ctx (.-currentContext viewport-key)]
    (when (some? ctx)
      (let [^m/RenderBox box (.-renderObject ctx)
            ^m/Size size (.-size box)
            outcome (interaction/snap-to-content st width height (.-width size) (.-height size))
            {:keys [zoom pan_x pan_y]} (:visualization (:store outcome))
            mat (doto (m/Matrix4.identity)
                  (.translate pan_x pan_y)
                  (.scale ^double zoom))]
        (apply-outcome! store-atom ui-atom outcome)
        (.-value! transform-controller mat)))))

(defn- canvas-body [st ui store-atom ui-atom last-scale transform-controller]
  (let [filtered     (get-in st [:visualization :filtered_timeline])
        active-ids   (if (some? filtered) [filtered] (keys (:timelines st)))
        fading-out   (:fading-out-timelines ui)
        timeline-ids (into (vec active-ids) fading-out)
        zoom         (double (get-in st [:visualization :zoom] 1.0))]
    (m/Listener
      .onPointerSignal
      (fn [^g/PointerSignalEvent event]
        (when (instance? g/PointerScrollEvent event)
          (apply-wheel-zoom! transform-controller store-atom
                              (.-dy (.-scrollDelta ^g/PointerScrollEvent event))
                              (.-localPosition ^g/PointerScrollEvent event)))
        nil)
      .child
      (m/InteractiveViewer
        .key viewport-key
        .transformationController transform-controller
        .constrained false
        ;; Pan/zoom are always available (rule ViewportPans/ViewportZooms,
        ;; neither filter-gated) -- an infinite boundary is what makes that
        ;; true regardless of content size: a finite margin lets Flutter
        ;; lock an axis outright once content+margin no longer exceeds the
        ;; viewport, e.g. right after filtering down to one small timeline.
        .boundaryMargin (m/EdgeInsets.all double/infinity)
        .minScale config/min-zoom
        .maxScale config/max-zoom
        .onInteractionStart
        (fn [_] (reset! last-scale 1.0) (swap! store-atom #(:store (interaction/begin-interaction %))) nil)
        .onInteractionEnd
        (fn [_] (swap! store-atom #(:store (interaction/end-interaction %))) nil)
        .onInteractionUpdate
        (fn [^m/ScaleUpdateDetails details]
          (let [delta (.-focalPointDelta details)
                cur-scale (.-scale details)
                zoom-ratio (/ cur-scale @last-scale)]
            (reset! last-scale cur-scale)
            (swap! store-atom #(:store (interaction/pan % (.-dx delta) (.-dy delta))))
            (when (not= zoom-ratio 1.0)
              (swap! store-atom #(:store (interaction/zoom % zoom-ratio)))))
          nil)
        .child
        (m/Column
          .mainAxisSize m/MainAxisSize.min
          .children
          (vec
            (interpose
              (m/SizedBox .height (canvas/timeline-gap zoom))
              (mapv (fn [tid]
                      (m/AnimatedOpacity
                        .key (m/ValueKey tid)
                        .opacity (double (get (:timeline-target-opacities ui) tid 1.0))
                        .duration (Duration .milliseconds config/animation-duration-ms)
                        .onEnd (fn []
                                 (swap! ui-atom update :fading-out-timelines disj tid)
                                 nil)
                        .child (timeline-widget st ui store-atom ui-atom tid)))
                    timeline-ids))))))))

;; == Overlays: field-flow banner, error banner, selection panels ============

(defn- error-banner
  "rules ErrorStateShowsMessage / RetryRestartsConnection: the failed-state
   overlay. The canvas stays mounted behind it (see overlay-stack), so Retry
   restarts the stream without losing what is already drawn."
  [{:keys [on-retry]}]
  (m/Material
    .color m/Colors.red.shade50
    .elevation 2.0
    .child (m/Padding .padding (m/EdgeInsets.all 8.0)
             .child (m/Row
                      .mainAxisSize m/MainAxisSize.min
                      .children
                      [(m/Text "Stream connection lost -- last known state shown below.")
                       (m/TextButton .onPressed (fn [] (on-retry) nil) .child (m/Text "Retry"))]))))

(defn- invalid-data-banner
  "rule InvalidDataVisible: the rest of the store is left intact, this is
   just a dismissible notice that one stream payload couldn't be applied."
  [{:keys [on-close]}]
  (m/Material
    .color m/Colors.amber.shade50
    .elevation 2.0
    .child (m/Padding .padding (m/EdgeInsets.all 8.0)
             .child (m/Row
                      .mainAxisSize m/MainAxisSize.min
                      .children
                      [(m/Text "Received invalid data from the stream -- ignored.")
                       (m/IconButton .icon (m/Icon m/Icons.close) .onPressed on-close)]))))

(defn- overlay-stack [st ui store-atom ui-atom last-scale transform-controller stream-handle]
  (m/Stack
    .children
    (filterv some?
      [(case (get-in st [:visualization :state])
         :empty (m/Center .child (m/Text "No timelines yet"))
         :rendered (canvas-body st ui store-atom ui-atom last-scale transform-controller)
         :error (canvas-body st ui store-atom ui-atom last-scale transform-controller)
         ;; nil (no snapshot yet) and :loading both show the spinner
         (m/Center .child (m/CircularProgressIndicator)))

       (when (= (get-in st [:visualization :state]) :error)
         (m/Align .alignment m/Alignment.topCenter
           .child (error-banner
                    ;; the retry starts a replacement driver, so it needs the
                    ;; same handle thread the app bar's reload already has
                    {:on-retry (fn [] (retry-stream! store-atom ui-atom stream-handle))})))

       (when (:invalid-data ui)
         (m/Align .alignment m/Alignment.bottomLeft
           .child (invalid-data-banner
                    {:on-close (fn [] (swap! ui-atom dissoc :invalid-data))})))

       (when (pos? (count (get-in st [:visualization :highlighted_path] #{})))
         (m/Align .alignment m/Alignment.topCenter
           .child
           (p.field-flow-trace/field-flow-trace-banner
             {:highlighted-element-names
              (mapv #(get-in st [:elements % :name]) (get-in st [:visualization :highlighted_path]))
              :on-clear
              (fn [] (apply-outcome! store-atom ui-atom (interaction/clear-field-flow-trace @store-atom)))})))

       (let [hovered-element (get-in st [:elements (:hovered-element ui)])]
         (when (false? (:is_information_complete hovered-element))
           (m/Align .alignment m/Alignment.bottomRight
             .child
             (p.incomplete-tooltip/incomplete-tooltip
                (let [conns (store/incoming-connections st (:id hovered-element))
                      conns-with-from (mapv #(assoc % :from-fields
                                                    (:fields (get-in st [:elements (:from %)])))
                                            conns)]
                  (model/unsourced-fields hovered-element conns-with-from))))))

       (when-some [eid (:selected-element ui)]
          (let [element (get-in st [:elements eid])]
            (m/Align .alignment m/Alignment.bottomCenter
             .child
             (p.element-details/element-details-panel
               {:element element
                :swimlane-name (get-in st [:swimlanes (:swimlane element) :name])
                :on-select-field
                (fn [field-name] (apply-outcome! store-atom ui-atom (interaction/select-field-for-trace @store-atom eid field-name)))
                :on-close (fn [] (swap! ui-atom assoc :selected-element nil))}))))

       (when-some [cid (:selected-connection ui)]
         (m/Align .alignment m/Alignment.bottomCenter
           .child
           (p.connection-details/connection-details-panel
             {:connection (get-in st [:connections cid])
              :from-name (get-in st [:elements (get-in st [:connections cid :from]) :name])
              :to-name (get-in st [:elements (get-in st [:connections cid :to]) :name])
              :on-close (fn [] (swap! ui-atom assoc :selected-connection nil))})))

       (when-some [sid (first (:expanded-slices ui))]
         (m/Align .alignment m/Alignment.bottomCenter
           .child
           (p.specification-expanded/specification-expanded-panel
             {:specifications
              (let [steps-by-spec (group-by :spec (vals (:spec-steps st)))]
                (mapv #(assoc % :steps (get steps-by-spec (:id %) []))
                      (filterv #(= (:slice %) sid) (vals (:specifications st)))))
              :expanded? true
              :element-name-fn (fn [eid] (get-in st [:elements eid :name]))
              :on-toggle (fn [] (swap! ui-atom update :expanded-slices disj sid))})))])))

;; == Root ======================================================================

(defn- app-bar [st store-atom ui-atom transform-controller stream-handle]
  (m/AppBar
    .title (m/Text (or (get-in st [:event-model :name]) "Event Model Visualization"))
    .actions
    [(m/IconButton
       .icon (m/Icon m/Icons.fit_screen)
       .tooltip "Snap to content"
       .onPressed (fn [] (snap-to-content! store-atom ui-atom transform-controller) nil))
     ;; rule ReloadRestartsConnection: force a fresh stream from a healthy one
     ;; so a new full snapshot reseeds the store; zoom/pan/filter/highlight are
     ;; deliberately left alone (reload refreshes the model, not the view).
     (m/IconButton
       .icon (m/Icon m/Icons.refresh)
       .tooltip "Reload model"
       .onPressed (fn [] (reload-model! store-atom ui-atom stream-handle) nil))]
    .bottom
    (m/PreferredSize
      .preferredSize (m/Size.fromHeight 40.0)
      .child
      (m/Align
        .alignment m/Alignment.centerLeft
        .child
        (m/SingleChildScrollView
          .scrollDirection m/Axis.horizontal
          .child
          (m/Row
            .mainAxisSize m/MainAxisSize.min
            .children
            (mapv (fn [t]
                    (p.timeline-filter/timeline-header
                      {:timeline t
                       :active? (= (:id t) (get-in st [:visualization :filtered_timeline]))
                       :on-filter (fn [tid] (apply-outcome! store-atom ui-atom (interaction/filter-to-timeline @store-atom tid)))
                       :on-clear (fn [] (apply-outcome! store-atom ui-atom (interaction/clear-timeline-filter @store-atom)))}))
                  (vals (:timelines st)))))))))

(defn- step-element-alphas
  "Called by the shared animation ticker each frame. Moves every entry in
   :element-current-alphas one step toward its target, removing entries that
   have arrived so the ticker listener is a no-op at steady state."
  [ui]
  (let [targets (:element-target-alphas ui)
        step    (/ 16.0 config/animation-duration-ms)]
    (if (empty? targets)
      ui
      (let [current' (reduce-kv
                       (fn [m eid target]
                         (let [cur (get m eid target)
                               nxt (if (< cur target)
                                     (min target (+ cur step))
                                     (max target (- cur step)))]
                           (assoc m eid nxt)))
                       (:element-current-alphas ui)
                       targets)
            done-eids (into [] (filter #(= (get current' %) (get targets %))) (keys targets))
            targets'  (apply dissoc targets done-eids)
            current'' (apply dissoc current' done-eids)]
        (assoc ui
               :element-target-alphas targets'
               :element-current-alphas current'')))))

(defn root []
  (f/widget
    :managed [store-atom (atom (store/initial-store)) :dispose nil]
    :managed [ui-atom (atom {:connection-visual {} :selected-element nil
                             :selected-connection nil :expanded-slices #{} :hovered-element nil
                             :failed-connection nil
                             :element-target-alphas {} :element-current-alphas {}
                             :fading-out-timelines #{} :timeline-target-opacities {}})
              :dispose nil]
    :managed [last-scale (atom 1.0) :dispose nil]
    :managed [transform-controller (m/TransformationController)]
    :vsync vsync
    :managed [anim-ticker (doto (m/AnimationController
                                  .vsync vsync
                                  .duration (Duration .milliseconds config/animation-duration-ms))
                            (.addListener (fn [] (swap! ui-atom step-element-alphas)))
                            (.repeat))]
    ;; the live SSE driver's handle (see start-stream!/retry-stream!/
    ;; reload-model!): EVERY place that starts a driver records its handle
    ;; here (cold start, retry, reload), so this atom always names the live
    ;; one and a restart can retire it before starting its replacement
    :managed [stream-handle (atom nil) :dispose nil]
    :managed [_ (reset! stream-handle (start-stream! store-atom ui-atom :connecting))
              :dispose nil]
    :watch [st store-atom]
    :watch [ui ui-atom]
    (m/MaterialApp .title "Event Model Visualization" .debugShowCheckedModeBanner false)
    .home
    (m/Scaffold
      .appBar (app-bar st store-atom ui-atom transform-controller stream-handle)
      .body (overlay-stack st ui store-atom ui-atom last-scale transform-controller stream-handle))))

(defn main [] (f/run (root)))
