(ns em-frontend.canvas
  "spec: the Canvas surface, plus the rendering conventions implied
   throughout the Rules section: canvas_fields per ElementKind, a persistent
   amber border while is_information_complete = false, and the
   highlighted/dimmed connection styling FieldFlowHighlights declares.
   AGENTS.md calls for a CustomPainter doing viewport-culled painting; one
   painter is built per Timeline (matching the Canvas surface's own
   `context timeline: Timeline`), so an off-screen timeline's table is
   simply never built -- that is the culling.
   Connections render right-to-left (ConnectionsRenderRightToLeft): `to`
   never sits at an earlier column than `from`, so edges are drawn from a
   from-card's right edge back to a to-card's left edge."
  (:require ["package:flutter/material.dart" :as m]
            ["dart:math" :as math]
            [em-frontend.store :as store]
            [em-frontend.layout :as layout]
            [em-frontend.model :as model]
            [em-frontend.edges :as edges]))

(def slice-status-fill
  {:created m/Colors.blue.shade200
   :in_progress m/Colors.amber.shade200
   :done m/Colors.green.shade200
   :informational m/Colors.grey.shade300})

(def slice-status-border
  {:created m/Colors.blue.shade600
   :in_progress m/Colors.amber.shade800
   :done m/Colors.green.shade700
   :informational m/Colors.grey.shade600})

(def element-kind-color
  {:command m/Colors.blue
   :event m/Colors.orange
   :read_model m/Colors.green
   :screen m/Colors.purple
   :automation m/Colors.blueGrey})

(def ^:private arrowhead-size 14.0)

(def timeline-title-base-font-size 48.0)
(def ^:private timeline-title-padding 24.0)

(defn timeline-title-font-size
  "Font size for the timeline title, scaled inversely with zoom so the title
   stays visually large as the user zooms out for an overview."
  ^double [^double zoom]
  (/ timeline-title-base-font-size zoom))

(defn timeline-title-height
  "Pixel height of the title strip above a timeline table. Grows as the user
   zooms out so the spacing between timelines tracks the title size."
  ^double [^double zoom]
  (+ (timeline-title-font-size zoom) timeline-title-padding))

;; == Low-level drawing helpers ================================================

(defn- ^m/Paint fill-paint [^m/Color color]
  (doto (m/Paint) (.-color! color)))

(defn- ^m/Paint stroke-paint [^m/Color color ^double width]
  (doto (m/Paint)
    (.-color! color)
    (.-style! m/PaintingStyle.stroke)
    (.-strokeWidth! width)))

(defn- rect->m [{:keys [x y width height]}]
  (m/Rect.fromLTWH x y width height))

(defn edge-endpoints
  "The (fx fy tx ty) anchor points an edge draws between. Anchors are always
   on the vertical mid-axis of each card: bottom-mid when the edge descends
   (from-rect above or level with to-rect in swimlane order), top-mid when it
   ascends. Direction is read from rect :y, which layout encodes as swimlane
   row position."
  [from-rect to-rect]
  (let [fx (+ (:x from-rect) (/ (:width from-rect) 2.0))
        tx (+ (:x to-rect)   (/ (:width to-rect)   2.0))]
    (if (<= (:y from-rect) (:y to-rect))
      [fx (+ (:y from-rect) (:height from-rect)) tx (:y to-rect)]
      [fx (:y from-rect) tx (+ (:y to-rect) (:height to-rect))])))

(defn- draw-arrowhead
  "A small filled triangle pointing along (from -> to), tip at `to`."
  [^m/Canvas canvas ^double from-x ^double from-y ^double to-x ^double to-y ^m/Color color]
  (let [angle (math/atan2 (- to-y from-y) (- to-x from-x))
        size arrowhead-size
        spread 0.45
        wing (fn [a] (m/Offset (- to-x (* size (math/cos (+ angle a))))
                                (- to-y (* size (math/sin (+ angle a))))))
        p1 (wing spread) p2 (wing (- spread))
        path (doto (m/Path)
               (.moveTo to-x to-y)
               (.lineTo (.-dx p1) (.-dy p1))
               (.lineTo (.-dx p2) (.-dy p2))
               (.close))]
    (.drawPath canvas path (fill-paint color))))

(defn- draw-text [^m/Canvas canvas ^String text ^double x ^double y ^m/TextStyle style ^double max-width]
  (let [tp (m/TextPainter
             .text (m/TextSpan .text text .style style)
             .textDirection m/TextDirection.ltr
             .ellipsis "…"
             .maxLines 1)]
    (.layout tp .maxWidth max-width)
    (.paint tp canvas (m/Offset x y))))

;; == Resolving one timeline's render model from the store ====================

(defn build-timeline-render-model
  "Resolves one timeline's slices/placements/elements/swimlanes/connections
   from the store into the geometry (via em-frontend.layout) and edge
   endpoints (via em-frontend.edges' same nearest-placement predicate the
   relayout rules use) that the painter below draws."
  [store-val timeline-id]
  (let [slices (filterv #(= (:timeline %) timeline-id) (vals (:slices store-val)))
        slice-ids (into #{} (map :id) slices)
        placements (filterv #(slice-ids (:slice %)) (vals (:placements store-val)))
        swimlane-order (mapv :id (sort-by :index (vals (:swimlanes store-val))))
        lay (layout/layout-timeline {:slices slices :placements placements
                                      :elements (:elements store-val)
                                      :swimlane-order swimlane-order})
        placement-by-id (into {} (map (fn [p] [(:placement-id p) p])) (:placements lay))
        placed-element-ids (into #{} (map :element) placements)
        candidate-connections
        (filter (fn [c] (or (contains? placed-element-ids (:from c))
                            (contains? placed-element-ids (:to c))))
                (vals (:connections store-val)))
        edge-lines-raw
        (for [c candidate-connections
              :let [from-geo (map #(store/placement-geometry store-val %)
                                   (store/placements-of-element store-val (:from c)))
                    to-geo (map #(store/placement-geometry store-val %)
                                 (store/placements-of-element store-val (:to c)))]
              {:keys [from to timeline]} (edges/drawn-edges from-geo to-geo)
              :when (= timeline timeline-id)
              :let [pf (get placement-by-id from) pt (get placement-by-id to)]
              :when (and pf pt)]
          {:connection-id (:id c) :from-rect (:rect pf) :to-rect (:rect pt)
           :from-col (:col pf) :to-col (:col pt)})
        lane-spacing 12.0
        edge-lines
        (vec (mapcat (fn [group]
                       (let [n (count group)]
                         (map-indexed (fn [i edge]
                                        (-> edge
                                            (assoc :x-nudge (* (- i (/ (dec n) 2.0)) lane-spacing))
                                            (dissoc :from-col :to-col)))
                                      group)))
                     (vals (group-by (juxt :from-col :to-col) edge-lines-raw))))]
    {:layout lay
     :slices (into {} (map (fn [s] [(:id s) s])) slices)
     :swimlanes (:swimlanes store-val)
     :swimlane-order swimlane-order
     :elements (:elements store-val)
     :edges edge-lines}))

;; == The painter ===============================================================

(defn- draw-element-card
  "Draws one element card onto `canvas` at `rect`. Factored out so the
   alpha-fading path can wrap it in saveLayer/restore."
  [^m/Canvas canvas rect element]
  (let [incomplete (false? (:is_information_complete element))
        kind-color (get element-kind-color (:kind element) m/Colors.grey)
        rrect (m/RRect.fromRectAndRadius (rect->m rect) (m/Radius.circular 6.0))]
    (.drawRRect canvas rrect (fill-paint m/Colors.white))
    (.drawRRect canvas rrect (stroke-paint (if incomplete m/Colors.amber kind-color)
                                            (if incomplete 2.5 1.5)))
    (draw-text canvas (or (:name element) "") (+ (:x rect) 8.0) (+ (:y rect) 8.0)
               (m/TextStyle .fontWeight m/FontWeight.bold .fontSize 13.0 .color m/Colors.black)
               (- (:width rect) 16.0))
    (doseq [[i field] (map-indexed vector (take 4 (model/canvas-fields element)))]
      (draw-text canvas (str (:name field) ": " (name (or (:type field) "")))
                 (+ (:x rect) 8.0) (+ (:y rect) 28.0 (* i 16.0))
                 (m/TextStyle .fontSize 11.0 .color m/Colors.grey.shade700)
                 (- (:width rect) 16.0)))))

(defn timeline-painter
  "render-model: as returned by build-timeline-render-model, plus
   connection-visual, a {connection-id -> :highlighted|:dimmed} map (see
   em-frontend.interaction/select-field-for-trace; absent means :normal),
   element-alphas, a {element-id -> double} map for in-flight fade
   animations (absent or 1.0 means fully opaque; saveLayer is used for any
   card whose alpha is not 1.0), title, the timeline's display name, and
   zoom, the current viewport zoom (used to size the title inversely so it
   grows as the user zooms out for an overview)."
  ^m/CustomPainter
  [{:keys [layout slices swimlanes elements edges connection-visual element-alphas title zoom]}]
  (let [zoom    (double (or zoom 1.0))
        title-h (timeline-title-height zoom)
        font-sz (timeline-title-font-size zoom)]
    (reify :extends m/CustomPainter
      (paint [this ^m/Canvas canvas ^m/Size size]
        (let [title-style (m/TextStyle .fontWeight m/FontWeight.bold .fontSize font-sz
                                        .color m/Colors.black87)
              tp (doto (m/TextPainter
                         .text (m/TextSpan .text (or title "") .style title-style)
                         .textDirection m/TextDirection.ltr
                         .ellipsis "…"
                         .maxLines 1)
                   (.layout .maxWidth (.-width size)))
              title-x (/ (- (.-width size) (.-width tp)) 2.0)
              title-y (/ (- title-h font-sz) 2.0)]
          (.paint tp canvas (m/Offset title-x title-y)))
        (.save canvas)
        (.translate canvas 0.0 title-h)
        (doseq [{:keys [rect swimlane-id]} (:swimlane-bands layout)]
          (.drawRect canvas (rect->m rect) (fill-paint m/Colors.grey.shade50))
          (when-some [sw (get swimlanes swimlane-id)]
            (draw-text canvas (or (:name sw) "") 4.0 (+ (:y rect) 8.0)
                       (m/TextStyle .fontSize 11.0 .fontWeight m/FontWeight.w500 .color m/Colors.black)
                       (- layout/swimlane-label-width 8.0))))
        (doseq [{:keys [slice-id rect]} (:slice-headers layout)
                :let [slice (get slices slice-id)]]
          (.drawRect canvas (rect->m rect)
                     (fill-paint (get slice-status-fill (:status slice) m/Colors.grey.shade100)))
          (.drawRect canvas (rect->m (assoc rect :y (- (+ (:y rect) (:height rect)) 3.0) :height 3.0))
                     (fill-paint (get slice-status-border (:status slice) m/Colors.grey.shade600)))
          (draw-text canvas (or (:title slice) "") (+ (:x rect) 8.0) (+ (:y rect) 8.0)
                     (m/TextStyle .fontWeight m/FontWeight.bold .fontSize 13.0 .color m/Colors.black)
                     (- (:width rect) 16.0)))
        (doseq [{:keys [connection-id from-rect to-rect x-nudge]} edges
                :let [visual (get connection-visual connection-id :normal)
                      color (case visual
                              :highlighted m/Colors.deepOrange
                              :dimmed m/Colors.grey.shade300
                              m/Colors.blueGrey)
                      width (if (= visual :highlighted) 4.0 2.0)
                       [fx fy tx ty] (edge-endpoints from-rect to-rect)
                       fx (+ fx x-nudge) tx (+ tx x-nudge)
                       dy (abs (- ty fy))
                       tension (max 40.0 (min 200.0 (* dy 0.5)))
                       descending? (<= fy ty)
                       curve-ty (if descending? (- ty arrowhead-size) (+ ty arrowhead-size))
                       cp1y (if descending? (+ fy tension) (- fy tension))
                       cp2y (if descending? (- curve-ty tension) (+ curve-ty tension))
                       path (doto (m/Path)
                              (.moveTo fx fy)
                              (.cubicTo fx cp1y tx cp2y tx curve-ty))]]
          (.drawPath canvas path (stroke-paint color width))
          (draw-arrowhead canvas tx cp2y tx ty color))
        (doseq [{:keys [element-id rect]} (:placements layout)
                :let [element (get elements element-id)
                      alpha   (get element-alphas element-id 1.0)]]
          (if (< alpha 1.0)
            (let [opacity-paint (doto (m/Paint)
                                  (.-color! (m/Color.fromARGB (int (* 255.0 alpha)) 255 255 255)))]
              (.saveLayer canvas (rect->m rect) opacity-paint)
              (draw-element-card canvas rect element)
              (.restore canvas))
            (draw-element-card canvas rect element)))
        (.restore canvas)
        nil)
      (shouldRepaint [this _] true))))

;; == Hit-testing (element/connection tap-to-select) ===========================

(defn hit-test-placement
  "The element-id of the placement card at `point` (widget-local
   coordinates), or nil."
  [layout ^m/Offset point]
  (let [x (.-dx point) y (.-dy point)]
    (some (fn [{:keys [element-id rect]}]
            (when (and (<= (:x rect) x (+ (:x rect) (:width rect)))
                       (<= (:y rect) y (+ (:y rect) (:height rect))))
              element-id))
          (:placements layout))))

(defn hit-test-slice-header
  "The slice-id of the column header at `point`, or nil -- opens
   SpecificationExpanded for that slice."
  [layout ^m/Offset point]
  (let [x (.-dx point) y (.-dy point)]
    (some (fn [{:keys [slice-id rect]}]
            (when (and (<= (:x rect) x (+ (:x rect) (:width rect)))
                       (<= (:y rect) y (+ (:y rect) (:height rect))))
              slice-id))
          (:slice-headers layout))))

(defn- point-bezier-distance
  "Minimum distance from (px, py) to the cubic Bezier with endpoints (fx, fy)
   and (tx, ty) and vertical control points cp1y / cp2y (control x = anchor x).
   Sampled at `steps` evenly-spaced t values."
  [px py fx fy cp1y cp2y tx ty steps]
  (reduce (fn [best i]
            (let [t  (/ i (double (dec steps)))
                  t' (- 1.0 t)
                  bx (+ (* t' t' t' fx) (* 3.0 t' t' t fx) (* 3.0 t' t t tx) (* t t t tx))
                  by (+ (* t' t' t' fy) (* 3.0 t' t' t cp1y) (* 3.0 t' t t cp2y) (* t t t ty))
                  d  (math/sqrt (+ (* (- px bx) (- px bx)) (* (- py by) (- py by))))]
              (if (< d best) d best)))
          1.0e18
          (range steps)))

(defn hit-test-edge
  "The connection-id of the edge curve passing within `threshold` px of
   `point`, or nil."
  [edges ^m/Offset point threshold]
  (let [x (.-dx point) y (.-dy point)]
    (some (fn [{:keys [connection-id from-rect to-rect x-nudge]}]
            (let [[fx fy tx ty] (edge-endpoints from-rect to-rect)
                  fx   (+ fx x-nudge) tx (+ tx x-nudge)
                  dy   (abs (- ty fy))
                  tension (max 40.0 (min 200.0 (* dy 0.5)))
                  descending? (<= fy ty)
                  cp1y (if descending? (+ fy tension) (- fy tension))
                  cp2y (if descending? (- ty tension) (+ ty tension))]
              (when (<= (point-bezier-distance x y fx fy cp1y cp2y tx ty 20)
                        threshold)
                connection-id)))
          edges)))
