(ns em-frontend.layout
  "spec: the canonical layout convention documented at the top of
   em-frontend.allium (timelines = tables stacked top-to-bottom; slices =
   columns ordered left-to-right by index; swimlanes = rows; a placement
   renders as its own card at (slice-column x swimlane-row)). Layout is
   per-timeline: this whole namespace operates on one timeline's own
   slices/placements/elements, matching every TimelineLaidOut rule's scope.
   AGENTS.md calls for a custom-built grid-layout calculator (no library);
   this is it.")

(def slice-width 252.0)
(def slice-header-height 56.0)
(def swimlane-row-height 168.0)
(def swimlane-label-width 96.0)
(def card-margin-h 24.0)
(def card-margin-v 32.0)

(defn- index-of [coll x]
  (first (keep-indexed (fn [i v] (when (= v x) i)) coll)))

(defn swimlane-row-index
  "Row 0 is the default unnamed band (element.swimlane = nil); named
   swimlanes occupy rows 1.. in `swimlane-order`."
  [swimlane-order element-swimlane-id]
  (if (nil? element-swimlane-id)
    0
    (if-some [i (index-of swimlane-order element-swimlane-id)]
      (inc i)
      0)))

(defn layout-timeline
  "in: {:slices [...] :placements [...] :elements {id -> element}
        :swimlane-order [swimlane-id ...]}
   slices/placements/elements are scoped to this one timeline already.
   out: per-placement cell rects (one per placement -- an element placed
   twice renders twice, never collapsed), per-slice column header rects,
   per-swimlane-row band rects, and the table's total size.
   Rows are compacted to only the swimlanes (and the default unnamed band)
   that actually hold a placement in this timeline -- an unused swimlane
   never reserves a blank row.
   When multiple placements share the same (col, row) cell they are placed
   side-by-side (horizontal sub-slots) with the same gap as between slices;
   the column widens to accommodate the maximum occupancy of any cell in it."
  [{:keys [slices placements elements swimlane-order]}]
  (let [ordered-slices (sort-by :index slices)
        col-index (into {} (map-indexed (fn [i s] [(:id s) i])) ordered-slices)
        placement-raw-rows
        (for [p placements
              :let [element (get elements (:element p))
                    col (get col-index (:slice p))]
              :when (some? col)]
          [p col (swimlane-row-index swimlane-order (:swimlane element))])
        used-raw-rows (vec (sort (distinct (map peek placement-raw-rows))))
        compacted-row (into {} (map-indexed (fn [i r] [r i])) used-raw-rows)
        row-count (count used-raw-rows)
        ;; count placements per (col, row) cell; assign a sub-slot index to each
        cell-counts (reduce (fn [acc [_ col raw-row]]
                              (update acc [col raw-row] (fnil inc 0)))
                            {} placement-raw-rows)
        ;; max occupancy per column drives the column width
        col-occupancy (reduce (fn [acc [[col _] n]]
                                (update acc col (fnil max 1) n))
                              {} cell-counts)
        ;; column width = base slice-width * occupancy (extra cards share the same margin budget)
        col-width (fn [col] (* slice-width (get col-occupancy col 1)))
        ;; cumulative x-offset per column
        col-x (reduce (fn [acc i]
                        (conj acc (+ (or (peek acc) swimlane-label-width)
                                     (col-width (dec i)))))
                      [swimlane-label-width]
                      (range 1 (inc (count ordered-slices))))
        card-width (- slice-width (* 2 card-margin-h))
        card-height (- swimlane-row-height (* 2 card-margin-v))
        ;; assign sub-slot counters per cell
        cell-slot-counter (atom {})
        placement-cells
        (for [[p col raw-row] placement-raw-rows
              :let [row (get compacted-row raw-row)
                    slot (get (swap! cell-slot-counter update [col row] (fnil inc 0))
                              [col row])
                    ;; slot is 1-based after swap; convert to 0-based
                    slot-idx (dec slot)]]
          {:placement-id (:id p)
           :element-id (:element p)
           :col col :row row
           :rect {:x (+ (nth col-x col) card-margin-h
                        (* slot-idx (+ card-width (* 2 card-margin-h))))
                  :y (+ slice-header-height (* row swimlane-row-height) card-margin-v)
                  :width card-width
                  :height card-height}})
        table-width (nth col-x (count ordered-slices) swimlane-label-width)
        slice-headers
        (for [[i s] (map-indexed vector ordered-slices)]
          {:slice-id (:id s) :index i
           :rect {:x (nth col-x i) :y 0.0
                  :width (col-width i) :height slice-header-height}})
        swimlane-bands
        (for [raw-row used-raw-rows
              :let [row (get compacted-row raw-row)]]
          {:row row
           :swimlane-id (when (pos? raw-row) (nth swimlane-order (dec raw-row) nil))
           :rect {:x 0.0 :y (+ slice-header-height (* row swimlane-row-height))
                  :width table-width :height swimlane-row-height}})]
    {:placements placement-cells
     :slice-headers slice-headers
     :swimlane-bands swimlane-bands
     :size {:width table-width :height (+ slice-header-height (* row-count swimlane-row-height))}}))
