(ns em-frontend.config
  "spec: config { ... }")

;; Zoom/pan seeded on first load, before any user interaction (config.default_*),
;; and the hard zoom boundaries enforced on every zoom gesture (config.min/max_zoom).
(def default-zoom 1.0)
(def default-pan-x 0.0)
(def default-pan-y 0.0)

(def min-zoom 0.1)
(def max-zoom 5.0)

;; A renderer constant with no spec counterpart: the spec models animation as
;; effect identity only, not timing -- left to the renderer in the same spirit as the layout geometry and extent measurement.
(def animation-duration-ms 250)
