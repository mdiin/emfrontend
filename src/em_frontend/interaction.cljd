(ns em-frontend.interaction
  "spec: rules under `Interaction-deferred delta processing` and `Visual
   marking and tracing`, plus the actions provided by the Viewport,
   TimelineFilter and FieldFlowTrace surfaces. Every function here is a pure
   `store -> {:store :effects}` transform, same shape as em-frontend.store's
   rule functions."
  (:require [em-frontend.config :as config]
            [em-frontend.model :as model]
            [em-frontend.store :as store]))

(defn- clamp [v lo hi] (max lo (min hi v)))

;; == Gesture begin/end, deferring deltas =====================================

(defn begin-interaction
  "rule InteractionBegins"
  [store]
  (if (false? (get-in store [:visualization :interacting]))
    {:store (assoc-in store [:visualization :interacting] true) :effects []}
    {:store store :effects []}))

(defn end-interaction
  "rule InteractionEnds, chained into InteractionEndFlushesQueue: ending a
   gesture (interacting becomes false) flushes every deferred delta batch,
   in commit order, through the same apply-delta-batch each would have used
   had it not been deferred."
  [store]
  (if (true? (get-in store [:visualization :interacting]))
    (let [cleared (-> store (assoc-in [:visualization :interacting] false) (assoc :delta-queue []))
          queued (:delta-queue store)]
      (reduce (fn [{s :store fx :effects} changes]
                (let [{s' :store fx' :effects} (store/apply-delta-batch s changes)]
                  {:store s' :effects (into fx fx')}))
              {:store cleared :effects [{:type :queued-deltas-flushed}]}
              queued))
    {:store store :effects []}))

;; == Viewport surface: pan / zoom / resize ===================================

(defn pan
  "rule ViewportPans: pan_x/pan_y are the cumulative delta from gesture
   start, not an absolute set. Always available, filtered view or not."
  [store dx dy]
  {:store (-> store
              (update-in [:visualization :pan_x] + dx)
              (update-in [:visualization :pan_y] + dy))
   :effects []})

(defn zoom
  "rule ViewportZooms: multiplicative, clamped to [config/min-zoom, config/max-zoom]."
  [store factor]
  {:store (update-in store [:visualization :zoom]
                      #(clamp (* % factor) config/min-zoom config/max-zoom))
   :effects []})

(defn resize-viewport
  "rule ViewportResizes: pure renderer concern, no entity state changes."
  [store width height]
  {:store store :effects [{:type :canvas-resized :width width :height height}]})

(defn snap-to-content
  "rule ViewportSnapsToContent: fits + centers the ENTIRE model, clearing any
   active timeline filter first (the fit is over the whole model, never a
   filtered subset). content-width/height and viewport-width/height are the
   renderer's own measurements (em-frontend.canvas/layout content extent, the
   InteractiveViewer's own rendered size) -- content_fit_zoom/
   content_center_pan_x/content_center_pan_y in the spec, which deliberately
   leaves that arithmetic unspecified. An empty model (no laid-out content)
   resets to config's defaults rather than dividing by zero."
  [store content-width content-height viewport-width viewport-height]
  (let [was-filtered (some? (get-in store [:visualization :filtered_timeline]))
        empty-content (or (zero? content-width) (zero? content-height))
        fitted-zoom (if empty-content
                      config/default-zoom
                      (clamp (min (/ viewport-width content-width) (/ viewport-height content-height))
                             config/min-zoom config/max-zoom))
        pan-x (if empty-content config/default-pan-x (/ (- viewport-width (* content-width fitted-zoom)) 2))
        pan-y (if empty-content config/default-pan-y (/ (- viewport-height (* content-height fitted-zoom)) 2))
        store' (-> store
                   (assoc-in [:visualization :filtered_timeline] nil)
                   (assoc-in [:visualization :zoom] fitted-zoom)
                   (assoc-in [:visualization :pan_x] pan-x)
                   (assoc-in [:visualization :pan_y] pan-y))]
    {:store store'
     :effects (if was-filtered
                (mapv (fn [tid] {:type :timeline-appears :timeline tid}) (keys (:timelines store)))
                [])}))

;; == TimelineFilter surface ===================================================

(defn filter-to-timeline
  "rule TimelineFilterScopes"
  [store timeline-id]
  (let [other-ids (remove #(= % timeline-id) (keys (:timelines store)))]
    {:store (assoc-in store [:visualization :filtered_timeline] timeline-id)
     :effects (conj (mapv (fn [tid] {:type :timeline-disappears :timeline tid}) other-ids)
                    {:type :timeline-appears :timeline timeline-id})}))

(defn clear-timeline-filter
  "rule TimelineFilterCleared"
  [store]
  (if (some? (get-in store [:visualization :filtered_timeline]))
    {:store (assoc-in store [:visualization :filtered_timeline] nil)
     :effects (mapv (fn [tid] {:type :timeline-appears :timeline tid}) (keys (:timelines store)))}
    {:store store :effects []}))

;; == FieldFlowTrace surface ===================================================

(defn- incoming-with-from
  "The connections into `element-id`, each augmented with :from-fields (its from
   element's :fields vector) -- the shape em-frontend.model's sourcing
   predicates expect, built here exactly as the incomplete-tooltip caller in
   em-frontend.app builds it."
  [store element-id]
  (mapv #(assoc % :from-fields (:fields (get-in store [:elements (:from %)])))
        (store/incoming-connections store element-id)))

(defn- supplies-field?
  "Does connection `c` supply `field-name` to its to-element? `c` carries the
   model's :carried/:derived sourcing sets, the one definition of the
   predicate; :carried together with (keys :derived) is what it supplies."
  [c field-name]
  (or (contains? (:carried c) field-name)
      (contains? (:derived c) field-name)))

(defn- upstream-of
  "The (element, field) pairs a supplying connection pushes onto the frontier
   once it has supplied `field-name`: (from, field-name) for a same-named
   carrier (the value keeps its name upstream), and (from, each source field)
   for a satisfied derivation. A connection that does both pushes both; a
   derivation with no source fields pushes nothing, so the walk roots there."
  [c field-name]
  (into (if (contains? (:carried c) field-name) [[(:from c) field-name]] [])
        (map (fn [source] [(:from c) source]))
        (get (:derived c) field-name #{})))

(defn select-field-for-trace
  "rule FieldFlowHighlights: highlights the connections that carry `field-name`
   INTO `element-id`, transitively upstream, and dims every other connection in
   the store (also when the traced set is empty). The walk is rooted at
   (element, field) rather than being model-wide, so a connection elsewhere in
   the model that merely mentions the same field name is not highlighted unless
   a chain of supplying connections actually leads into the element.

   A connection supplies a field name n to the element it points at when either
   its from-element has a field named n (carried) or it carries a fully
   satisfied FieldDerivation targeting n -- em-frontend.model/supplying-connections
   is that predicate, the same carried/derived notion
   Element.is_information_complete and unsourced-fields read.

   The walk starts at (element, field-name). If that element introduces the
   field via a FieldOrigin the value originates there, so the walk stops -- the
   element stays on the traced path but nothing upstream of it does.
   Otherwise every incoming connection supplying the field is added to the
   traced set and pushes upstream: (from, each source field) for a satisfied
   derivation, (from, the same field name) for a carrier. Termination: the
   frontier only ever holds (element, field) pairs taken from the model's
   finite element and field-name sets, and a visited set of pairs that have
   been expanded means each pair is pushed and expanded at most once, so the
   frontier empties -- even when connections form a cycle across timelines,
   which ConnectionsRenderRightToLeft deliberately leaves unconstrained.
   Pure and Dart-free, so it stays unit-testable.

   `highlighted_path` records the traced elements -- every from/to endpoint of
   an on-path connection."
  [store element-id field-name]
  (let [connections (vals (:connections store))
        introducing? (fn [eid field] (contains? (model/origin-field-names (get-in store [:elements eid]))
                                                field))
        supplying (fn [eid] (model/supplying-connections (get-in store [:elements eid])
                                                         (incoming-with-from store eid)))
        on-path-ids (loop [frontier [[element-id field-name]] visited #{} on-path #{}]
                      (if (seq frontier)
                        (let [[eid field] (first frontier)
                              rest-frontier (rest frontier)]
                          (if (or (contains? visited [eid field]) (introducing? eid field))
                            (recur rest-frontier (conj visited [eid field]) on-path)
                            (let [supplying-field (filterv #(supplies-field? % field) (supplying eid))]
                              (recur (into rest-frontier (mapcat #(upstream-of % field)) supplying-field)
                                     (conj visited [eid field])
                                     (into on-path (map :id) supplying-field)))))
                        on-path))
        grouped (group-by #(contains? on-path-ids (:id %)) connections)
        on-path (get grouped true [])
        off-path (get grouped false [])]
    {:store (assoc-in store [:visualization :highlighted_path]
                      (into #{} (mapcat (fn [c] [(:from c) (:to c)])) on-path))
     :effects (into (mapv (fn [c] {:type :connection-highlighted :connection (:id c)}) on-path)
                    (map (fn [c] {:type :connection-dimmed :connection (:id c)}))
                    off-path)}))

(defn clear-field-flow-trace
  "The FieldFlowTrace surface's only other provided action; no separate
   named rule covers it beyond resetting the trace FieldFlowHighlights set.
   Emits :field-flow-trace-cleared so the Flutter layer can reset the
   transient connection-visual map (the highlighted/dimmed edge styling)."
  [store]
  {:store (assoc-in store [:visualization :highlighted_path] #{})
   :effects [{:type :field-flow-trace-cleared}]})
