(ns em-frontend.canvas-test
  "Tests for pure geometry helpers in em-frontend.canvas: swimlane-aware
   vertical anchor selection (edge-endpoints), per-bundle x-nudge
   assignment (build-timeline-render-model stagger logic, exercised here
   directly from the underlying grouping math), and card-presentation, the
   pure decision a placement's card is drawn from -- including the element
   record this client never received. The material import is for those
   colour assertions only."
  (:require [cljd.test :refer [deftest is testing]]
            ["package:flutter/material.dart" :as m]
            [em-frontend.canvas :as canvas]))

;; == edge-endpoints ==========================================================

;; Rect helpers: layout places cards at y = slice-header-height + row * swimlane-row-height + card-margin
;; (56 + row*120 + 8 = 64 + row*120). Width/height are fixed (204 x 104).
(defn- rect [col row]
  {:x (+ 96.0 (* col 220.0) 8.0)
   :y (+ 56.0 (* row 120.0) 8.0)
   :width 204.0 :height 104.0})

(deftest descending-anchors-test
  (testing "from above to below: exit bottom-mid of from, enter top-mid of to"
    (let [fr (rect 0 0) tr (rect 1 1)
          [fx fy tx ty] (canvas/edge-endpoints fr tr)]
      (is (= fx (+ (:x fr) (/ (:width fr) 2.0))))
      (is (= fy (+ (:y fr) (:height fr))))   ; bottom of from
      (is (= tx (+ (:x tr) (/ (:width tr) 2.0))))
      (is (= ty (:y tr))))))                 ; top of to

(deftest ascending-anchors-test
  (testing "from below to above: exit top-mid of from, enter bottom-mid of to"
    (let [fr (rect 0 1) tr (rect 1 0)
          [fx fy tx ty] (canvas/edge-endpoints fr tr)]
      (is (= fx (+ (:x fr) (/ (:width fr) 2.0))))
      (is (= fy (:y fr)))                              ; top of from
      (is (= tx (+ (:x tr) (/ (:width tr) 2.0))))
      (is (= ty (+ (:y tr) (:height tr)))))))          ; bottom of to

(deftest same-row-treated-as-descending-test
  (testing "same swimlane row (y equal): exit bottom-mid, enter top-mid"
    (let [fr (rect 0 0) tr (rect 1 0)
          [fx fy tx ty] (canvas/edge-endpoints fr tr)]
      (is (= fy (+ (:y fr) (:height fr))))   ; bottom of from
      (is (= ty (:y tr))))))                 ; top of to

(deftest same-column-same-row-test
  (testing "same column, same row (degenerate): bottom-mid to top-mid"
    (let [fr (rect 0 0) tr (rect 0 0)
          [fx fy tx ty] (canvas/edge-endpoints fr tr)]
      (is (= fy (+ (:y fr) (:height fr))))
      (is (= ty (:y tr))))))

;; == x-nudge grouping ========================================================
;;
;; The nudge logic lives inside build-timeline-render-model, so we test it by
;; replicating the grouping formula and verifying the offsets it produces.

(defn- nudges-for [from-to-col-pairs]
  (let [lane-spacing 12.0
        raw (map-indexed (fn [i [fc tc]] {:from-col fc :to-col tc :i i}) from-to-col-pairs)
        groups (group-by (juxt :from-col :to-col) raw)]
    (into {}
          (mapcat (fn [group]
                    (let [n (count group)]
                      (map-indexed (fn [gi edge]
                                     [(:i edge) (* (- gi (/ (dec n) 2.0)) lane-spacing)])
                                   group)))
                  (vals groups)))))

(deftest single-edge-no-nudge-test
  (testing "a lone edge in its group gets nudge 0.0"
    (let [result (nudges-for [[0 1]])]
      (is (= 0.0 (get result 0))))))

(deftest two-edges-same-pair-test
  (testing "two edges sharing (from-col, to-col) are offset by ±lane-spacing/2"
    (let [result (nudges-for [[0 1] [0 1]])]
      (is (= #{-6.0 6.0} (into #{} (vals result)))))))

(deftest three-edges-same-pair-test
  (testing "three edges in the same group get offsets -12, 0, +12"
    (let [result (nudges-for [[0 1] [0 1] [0 1]])]
      (is (= #{-12.0 0.0 12.0} (into #{} (vals result)))))))

(deftest different-pairs-independent-nudge-test
  (testing "edges in different (from-col, to-col) groups are each nudged independently"
    (let [result (nudges-for [[0 1] [1 2] [0 1]])]
      ;; edges 0 and 2 share group (0,1); edge 1 is alone in group (1,2)
      (is (= #{-6.0 6.0} (into #{} (map result [0 2]))))
      (is (= 0.0 (get result 1))))))

;; == timeline-title-font-size / timeline-title-height ========================

(deftest title-font-size-at-default-zoom-test
  (testing "at zoom 1.0 returns the base font size"
    (is (= canvas/timeline-title-base-font-size
           (canvas/timeline-title-font-size 1.0)))))

(deftest title-font-size-grows-when-zoomed-out-test
  (testing "zooming out doubles the font size at zoom 0.5"
    (is (= (* 2.0 canvas/timeline-title-base-font-size)
           (canvas/timeline-title-font-size 0.5)))))

(deftest title-font-size-shrinks-when-zoomed-in-test
  (testing "zooming in halves the font size at zoom 2.0"
    (is (= (* 0.5 canvas/timeline-title-base-font-size)
           (canvas/timeline-title-font-size 2.0)))))

(deftest title-height-grows-with-zoom-out-test
  (testing "title height at zoom 0.5 is larger than at zoom 1.0"
    (is (> (canvas/timeline-title-height 0.5)
           (canvas/timeline-title-height 1.0)))))

;; == timeline-gap =============================================================

(deftest timeline-gap-is-twice-title-height-test
  (testing "gap between timelines equals 2× the title height"
    (is (= (* 2.0 (canvas/timeline-title-height 1.0))
           (canvas/timeline-gap 1.0)))))

;; == wf-leaf-label ============================================================

(deftest wf-leaf-label-attr-priority-test
  (testing "leaf label prefers label, then placeholder, then alt, then name"
    (let [attrs {:label "Go" :placeholder "Search..." :alt "img" :name "f"}]
      (is (= "Go" (canvas/wf-leaf-label :button attrs)))
      (is (= "Search..." (canvas/wf-leaf-label :input (dissoc attrs :label))))
      (is (= "img" (canvas/wf-leaf-label :image (dissoc attrs :label :placeholder))))
      (is (= "f" (canvas/wf-leaf-label :input (dissoc attrs :label :placeholder :alt)))))))

(deftest wf-leaf-label-falls-back-to-tag-name-test
  (testing "with no naming attrs, the label is the tag's name without the colon"
    (is (= "button" (canvas/wf-leaf-label :button {})))))

(deftest wf-leaf-label-nil-tag-test
  (testing "a node with no tag (e.g. a bare string child) yields nil, not a crash"
    (is (nil? (canvas/wf-leaf-label nil {})))))

;; == band-shade ==============================================================

(deftest band-shade-alternates-test
  (testing "rule AlternatingBandShading: adjacent band indices get different
            shades, and every other index repeats the same shade"
    (is (not= (canvas/band-shade 0) (canvas/band-shade 1)))
    (is (= (canvas/band-shade 0) (canvas/band-shade 2)))
    (is (= (canvas/band-shade 1) (canvas/band-shade 3)))))

;; == hit-test-placement ======================================================

;; Layout maps are hand-built in the shape build-timeline-render-model produces:
;; placements carry :element-id and a :rect, slice headers carry :slice-id and
;; a :rect. All coordinates are widget-local.
(def ^:private sample-layout
  {:placements [{:element-id :e1 :rect {:x 10.0 :y 20.0 :width 100.0 :height 50.0}}
                {:element-id :e2 :rect {:x 200.0 :y 20.0 :width 100.0 :height 50.0}}]
   :slice-headers [{:slice-id :s1 :rect {:x 0.0 :y 0.0 :width 200.0 :height 56.0}}]})

(deftest hit-test-placement-inside-test
  (testing "a point inside a placement's rect returns its element-id"
    (is (= :e1 (canvas/hit-test-placement sample-layout 50.0 40.0)))
    (is (= :e2 (canvas/hit-test-placement sample-layout 250.0 40.0)))))

(deftest hit-test-placement-miss-test
  (testing "a point outside every rect returns nil"
    (is (nil? (canvas/hit-test-placement sample-layout 5.0 40.0)))
    (is (nil? (canvas/hit-test-placement sample-layout 50.0 500.0)))))

(deftest hit-test-placement-inclusive-edges-test
  (testing "the rect bounds are inclusive (<= against x+width / y+height), so
            the right and bottom edges still hit, one pixel past does not"
    (is (= :e1 (canvas/hit-test-placement sample-layout 110.0 40.0)) "right edge")
    (is (= :e1 (canvas/hit-test-placement sample-layout 50.0 70.0)) "bottom edge")
    (is (nil? (canvas/hit-test-placement sample-layout 110.5 40.0)))
    (is (nil? (canvas/hit-test-placement sample-layout 50.0 70.5)))))

;; == hit-test-slice-header ===================================================

(deftest hit-test-slice-header-test
  (testing "a point inside a header rect returns the slice-id, a miss returns nil"
    (is (= :s1 (canvas/hit-test-slice-header sample-layout 100.0 20.0)))
    (is (nil? (canvas/hit-test-slice-header sample-layout 100.0 100.0)))))

;; == hit-test-edge ===========================================================

(deftest hit-test-edge-test
  (testing "a point on the curve within the threshold returns the connection-id;
            a far-away point returns nil"
    (let [from-rect (rect 0 0)
          to-rect   (rect 1 1)
          [fx fy]   (canvas/edge-endpoints from-rect to-rect)
          edges     [{:connection-id :c1 :from-rect from-rect :to-rect to-rect
                      :x-nudge 0.0}]]
      (is (= :c1 (canvas/hit-test-edge edges fx fy 1.0))
          "the from-anchor sits exactly on the curve")
      (is (= :c1 (canvas/hit-test-edge edges (+ fx 2.0) fy 6.0)))
      (is (nil? (canvas/hit-test-edge edges (+ fx 1000.0) fy 6.0))))))

;; == card-presentation =======================================================

;; A loaded element, as the wire supplies one (ids are integers, as on the
;; wire), plus the three inputs that are NOT a loaded element: nil, a bare
;; {id, name} reference (what a connection endpoint contributes to the element
;; index), and a record whose kind the palette does not know.

(def ^:private loaded-element
  {:id 1 :name "PlaceOrder" :kind :command :context :internal
   :is_information_complete true :fields [] :field_origins []
   :swimlane nil :image_url nil})

(deftest card-presentation-loaded-test
  (testing "a loaded record shows the element's own name and its kind's outline colour"
    (is (= {:unloaded? false :name "PlaceOrder"
            :outline-color m/Colors.blue :incomplete? false}
           (canvas/card-presentation 1 loaded-element)))
    (testing "an unnamed loaded element still shows the empty name it always did"
      (is (= "" (:name (canvas/card-presentation 1 (assoc loaded-element :name nil))))))
    (testing "the red ring follows is_information_complete, so an absent flag is not an incomplete one"
      (is (true? (:incomplete? (canvas/card-presentation
                                 1 (assoc loaded-element :is_information_complete false)))))
      (is (false? (:incomplete? (canvas/card-presentation
                                  1 (assoc loaded-element :is_information_complete nil)))))))
  (testing "an unknown kind is still a loaded record -- a card, in the grey fallback"
    (let [p (canvas/card-presentation 1 (assoc loaded-element :kind :mystery))]
      (is (false? (:unloaded? p)))
      (is (= m/Colors.grey (:outline-color p))))))

(deftest card-presentation-unloaded-test
  (testing "no record at all: unloaded, named by its id, and outlined in a colour
            that cannot be read as the grey an unknown kind gets"
    (let [p (canvas/card-presentation 9 nil)]
      (is (true? (:unloaded? p)))
      (is (= "element #9" (:name p)))
      (is (= m/Colors.amber.shade700 (:outline-color p)))
      (is (false? (:incomplete? p)))
      (is (not= (:outline-color (canvas/card-presentation 1 (assoc loaded-element :kind :mystery)))
                (:outline-color p))
          "a known element whose kind the palette lacks is told apart from a record this client never got")))
  (testing "a bare {id, name} reference is unloaded too, and keeps the name it does carry"
    (let [p (canvas/card-presentation 9 {:id 9 :name "CancelOrder"})]
      (is (true? (:unloaded? p)))
      (is (= "CancelOrder" (:name p)))
      (is (= m/Colors.amber.shade700 (:outline-color p))))))

;; == build-timeline-render-model: an unloaded placement =======================

;; A store holding a placement whose element record never arrived -- the
;; arrangement that used to be drawn as a nameless grey box.

(defn- store-with-an-unloaded-placement []
  {:timelines {1 {:id 1 :title "Checkout"}}
   :slices {10 {:id 10 :timeline 1 :title "Place order"
                :kind :state_change :status :done :index 0}}
   :swimlanes {}
   :elements {1 {:id 1 :name "PlaceOrder" :kind :command :context :internal
                 :is_information_complete true :fields [] :field_origins []
                 :swimlane nil :image_url nil}}
   :placements {100 {:id 100 :slice 10 :element 1}
                101 {:id 101 :slice 10 :element 9}}
   :connections {}})

(deftest build-timeline-render-model-keeps-an-unloaded-placement-cell-test
  (testing "a placement whose element never arrived still gets its cell, with the
            element left unresolved -- the placeholder is presentation-only, so
            nothing reflows and the table keeps the cell the element's card would
            have occupied"
    (let [model (canvas/build-timeline-render-model (store-with-an-unloaded-placement) 1)
          cells (:placements (:layout model))
          cell-of (fn [element-id] (first (filter #(= element-id (:element-id %)) cells)))]
      (is (= 2 (count cells)))
      (is (nil? (get (:elements model) 9))
          "the render model hands the painter no element for that placement")
      (is (some? (:rect (cell-of 9))))
      (is (= (:width (:rect (cell-of 1))) (:width (:rect (cell-of 9))))
          "an unloaded element is not a screen, so the cell keeps the default card size")
      (is (= (:height (:rect (cell-of 1))) (:height (:rect (cell-of 9))))))))
