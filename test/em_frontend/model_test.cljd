(ns em-frontend.model-test
  "spec: entity Element's derived values (origin_field_names,
   carried_field_names, derived_field_names, unsourced_fields, canvas_fields)
   -- categories projection, entity_relationship, entity_optional,
   value_equality, enum_comparable."
  (:require [cljd.test :refer [deftest is testing]]
            [em-frontend.model :as model]))

(def field-a {:name "amount" :type :decimal :optional false :cardinality :single :subfields []})
(def field-b {:name "total" :type :decimal :optional false :cardinality :single :subfields []})
(def field-c {:name "notes" :type :string :optional true :cardinality :single :subfields []})

(deftest origin-field-names-test
  (testing "field_origins -> field"
    (is (= #{"amount"} (model/origin-field-names {:field_origins [{:field "amount" :origin :user_input}]})))
    (is (= #{} (model/origin-field-names {:field_origins []})))))

(deftest carried-field-names-test
  (testing "same-name field on a from-element is carried"
    (is (= #{"amount"}
           (model/carried-field-names
             {:fields [field-a]}
             [{:from-fields [field-a] :derivations []}]))))
  (testing "no match when from has no field of same name"
    (is (= #{}
           (model/carried-field-names
             {:fields [field-a]}
             [{:from-fields [field-c] :derivations []}]))))
  (testing "no incoming connections -- nothing carried"
    (is (= #{} (model/carried-field-names {:fields [field-a]} [])))))

(deftest derived-field-names-test
  (testing "fully-satisfied derivation sources the target field"
    (is (= #{"total"}
           (model/derived-field-names
             [{:from-fields [field-a]
               :derivations [{:target_field "total" :source_fields ["amount"]}]}]))))
  (testing "derivation with absent source_field does not source the target"
    (is (= #{}
           (model/derived-field-names
             [{:from-fields []
               :derivations [{:target_field "total" :source_fields ["amount"]}]}]))))
  (testing "aggregation: all source_fields must be present on the from-element"
    (is (= #{}
           (model/derived-field-names
             [{:from-fields [field-a]
               :derivations [{:target_field "total" :source_fields ["amount" "notes"]}]}]))))
  (testing "multiple connections targeting the same field: any one satisfied derivation suffices"
    (is (= #{"total"}
           (model/derived-field-names
             [{:from-fields []
               :derivations [{:target_field "total" :source_fields ["amount"]}]}
              {:from-fields [field-a]
               :derivations [{:target_field "total" :source_fields ["amount"]}]}]))))
  (testing "no connections -- nothing derived"
    (is (= #{} (model/derived-field-names [])))))

(deftest unsourced-fields-test
  (testing "carried field (same name on from-element) is sourced"
    (is (= [field-b]
           (model/unsourced-fields
             {:fields [field-a field-b] :field_origins []}
             [{:from-fields [field-a] :derivations []}]))))
  (testing "derived field sourced when derivation fully satisfied"
    (is (= []
           (model/unsourced-fields
             {:fields [field-b] :field_origins []}
             [{:from-fields [field-a]
               :derivations [{:target_field "total" :source_fields ["amount"]}]}]))))
  (testing "derived field unsourced when derivation source absent from from-element"
    (is (= [field-b]
           (model/unsourced-fields
             {:fields [field-b] :field_origins []}
             [{:from-fields []
               :derivations [{:target_field "total" :source_fields ["amount"]}]}]))))
  (testing "any one satisfied derivation across connections suffices"
    (is (= []
           (model/unsourced-fields
             {:fields [field-b] :field_origins []}
             [{:from-fields []
               :derivations [{:target_field "total" :source_fields ["amount"]}]}
              {:from-fields [field-a]
               :derivations [{:target_field "total" :source_fields ["amount"]}]}]))))
  (testing "introduced field sourced regardless of connections"
    (is (= []
           (model/unsourced-fields
             {:fields [field-a] :field_origins [{:field "amount" :origin :user_input}]}
             []))))
  (testing "no origin, no incoming -- every field unsourced"
    (is (= [field-a field-b]
           (model/unsourced-fields {:fields [field-a field-b] :field_origins []} [])))))

(deftest canvas-fields-test
  (testing "command/event/read_model show their fields on the canvas card"
    (doseq [kind [:command :event :read_model]]
      (is (= [field-a] (model/canvas-fields {:kind kind :fields [field-a]})))))
  (testing "screen and automation show none, regardless of declared fields"
    (doseq [kind [:screen :automation]]
      (is (= [] (model/canvas-fields {:kind kind :fields [field-a]}))))))

(deftest value-type-structural-equality-test
  (testing "Field, FieldDerivation, FieldOrigin, Example are plain maps: structural equality, not identity"
    (is (= field-a (assoc {} :name "amount" :type :decimal :optional false :cardinality :single :subfields [])))
    (is (= {:target_field "total" :source_fields ["amount"]}
           {:target_field "total" :source_fields ["amount"]}))
    (is (= {:field "amount" :origin :user_input} {:field "amount" :origin :user_input}))
    (is (= {:field_name "amount" :field_value "42"} {:field_name "amount" :field_value "42"}))))

(deftest enum-comparable-test
  (testing "enum members compare by value across separately-constructed instances"
    (is (= :command :command))
    (is (not= :command :event))
    (is (= :list :list))
    (is (= :done :done))
    (is (not= :done :in_progress))))
