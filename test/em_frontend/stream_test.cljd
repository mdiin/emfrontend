(ns em-frontend.stream-test
  "spec: contract ChangeStream. Fixtures below are the guard against
   wire-schema drift, not a re-statement of my own assumptions: the snapshot
   is a live `emcli.app/snapshot` payload, reproduced by driving
   `emcli.commands/run` through the real commit path (the scenario is listed
   above that fixture), the two element deltas (CreateElement, SetImageUrl)
   and the DeleteTimeline cascade are verbatim from
   ../thecli/docs/change-stream.md's own worked examples, and
   delta-add-wireframe's wireframe subtree was generated by emcli's own node
   builders and serialized by the same JSON writer the stream uses -- see the
   regeneration command above that fixture."
  (:require [cljd.test :refer [deftest is testing]]
            [em-frontend.model :as model]
            [em-frontend.store :as store]
            [em-frontend.stream :as stream]))

;; A live `emcli.app/snapshot` payload: one timeline, one slice, two
;; placed+connected elements (one with an unsourced field, hence
;; is_information_complete=false; the other complete through the field that
;; connection carries and the one it derives), one swimlane assignment, one
;; element (10) created and never placed or wired -- the element whose absence
;; from the nested projections is the grey-box report's subject -- and a
;; specification whose step references element 5 through a nested {id, name} ref.
;; Reproduced by driving emcli.commands/run through the real commit path:
;;
;;   (app/new-app "model"); create-timeline "Foobar"; create-swimlane "Sales";
;;   add-slice "Place order" :state_change; create-element "PlaceOrder"
;;   :command + fields orderId/amount; create-element "OrderPlaced" :event +
;;   fields orderId/total; assign-swimlane (the command, "Sales");
;;   place-element both; connect; add-derivation total <- amount;
;;   create-element "OrderCancelled" :event; add-specification "Happy path";
;;   add-spec-step :when_step element PlaceOrder index 0;
;;   then (app/snapshot app) -> this string.
;;
;; Ids: model 1, timeline 2, swimlane 3, slice 4, elements 5, 6 and 10,
;; placements 7 and 8, connection 9, specification 11, spec-step 12.
(def real-snapshot
  "{\"op\":\"snapshot\",\"model\":{\"id\":1,\"name\":\"model\",\"elements\":[{\"field_origins\":[],\"name\":\"PlaceOrder\",\"swimlane\":3,\"fields\":[{\"name\":\"orderId\",\"type\":\"uuid\"},{\"name\":\"amount\",\"type\":\"decimal\"}],\"type\":\"element\",\"id\":5,\"kind\":\"command\",\"context\":\"internal\",\"is_information_complete\":false,\"model\":1},{\"field_origins\":[],\"name\":\"OrderPlaced\",\"fields\":[{\"name\":\"orderId\",\"type\":\"uuid\"},{\"name\":\"total\",\"type\":\"decimal\"}],\"type\":\"element\",\"id\":6,\"kind\":\"event\",\"context\":\"internal\",\"is_information_complete\":true,\"model\":1},{\"field_origins\":[],\"name\":\"OrderCancelled\",\"fields\":[],\"type\":\"element\",\"id\":10,\"kind\":\"event\",\"context\":\"internal\",\"is_information_complete\":true,\"model\":1}],\"timelines\":[{\"id\":2,\"title\":\"Foobar\",\"slices\":[{\"id\":4,\"title\":\"Place order\",\"kind\":\"state_change\",\"status\":\"created\",\"index\":0,\"is_complete\":true,\"placements\":[{\"id\":7,\"index\":0,\"element\":{\"id\":5,\"name\":\"PlaceOrder\",\"kind\":\"command\",\"swimlane\":3,\"is_information_complete\":false,\"image_url\":null,\"wireframe\":null,\"fields\":[{\"name\":\"orderId\",\"type\":\"uuid\"},{\"name\":\"amount\",\"type\":\"decimal\"}]}},{\"id\":8,\"index\":1,\"element\":{\"id\":6,\"name\":\"OrderPlaced\",\"kind\":\"event\",\"swimlane\":null,\"is_information_complete\":true,\"image_url\":null,\"wireframe\":null,\"fields\":[{\"name\":\"orderId\",\"type\":\"uuid\"},{\"name\":\"total\",\"type\":\"decimal\"}]}}],\"specifications\":[{\"id\":11,\"title\":\"Happy path\",\"is_complete\":true,\"steps\":[{\"id\":12,\"clause\":\"when_step\",\"index\":0,\"is_error\":false,\"error_name\":null,\"element\":{\"id\":5,\"name\":\"PlaceOrder\"},\"examples\":[]}]}]}]}],\"swimlanes\":[{\"id\":3,\"name\":\"Sales\",\"index\":0}],\"connections\":[{\"id\":9,\"from\":{\"id\":5,\"name\":\"PlaceOrder\"},\"to\":{\"id\":6,\"name\":\"OrderPlaced\"},\"derivations\":[{\"target_field\":\"total\",\"source_fields\":[\"amount\"]}]}]}}")

(deftest normalize-real-snapshot-test
  (let [seed (stream/normalize-snapshot real-snapshot)]
    (testing "model, timeline, slice"
      (is (= {:id 1 :name "model"} (:model seed)))
      (is (= "Foobar" (get-in seed [:timelines 2 :title])))
      (is (= 2 (get-in seed [:slices 4 :timeline])))
      (is (= :state_change (get-in seed [:slices 4 :kind]))))
    (testing "placements resolve to element ids, not embedded objects"
      (is (= 5 (get-in seed [:placements 7 :element])))
      (is (= 6 (get-in seed [:placements 8 :element]))))
    (testing "the element index comes from the model's element registry, each entry
              the canonical record a delta carries -- context and field_origins
              included, which the placement's display projection does not have"
      (is (= "PlaceOrder" (get-in seed [:elements 5 :name])))
      (is (= :command (get-in seed [:elements 5 :kind])))
      (is (false? (get-in seed [:elements 5 :is_information_complete]))
          "the unsourced field costs element 5 its completeness")
      (is (= 3 (get-in seed [:elements 5 :swimlane])))
      (is (= :internal (get-in seed [:elements 5 :context])))
      (is (= [] (get-in seed [:elements 5 :field_origins])))
      (is (= 2 (count (get-in seed [:elements 5 :fields])))))
    (testing "swimlane"
      (is (= "Sales" (get-in seed [:swimlanes 3 :name]))))
    (testing "connection: from/to resolved to bare element ids from the
              partial embedded {id,name}, derivations intact"
      (is (= 5 (get-in seed [:connections 9 :from])))
      (is (= 6 (get-in seed [:connections 9 :to])))
      (is (= [{:target_field "total" :source_fields ["amount"]}]
             (get-in seed [:connections 9 :derivations]))))
    (testing "a snapshot spec-step's element ref is reduced to the bare id, the
              shape a delta's spec-step carries -- the snapshot nests {id,name}
              there, and every lookup against the store expects the id"
      (is (= 5 (get-in seed [:spec-steps 12 :element])))
      (is (= "PlaceOrder" (get-in seed [:elements (get-in seed [:spec-steps 12 :element]) :name]))))))

(deftest wire-is-information-complete-matches-derived-unsourced-fields-test
  (testing "A4 guard: the wire-supplied is_information_complete on every
            element agrees with the derived unsourced_fields the incomplete
            tooltip renders -- change-stream.md:100 and :224 both claim the
            flag is always present and is derived from field sourcing"
    (let [seed (stream/normalize-snapshot real-snapshot)
          conns-with-from (fn [element-id]
                            (mapv #(assoc % :from-fields
                                          (get-in seed [:elements (:from %) :fields]))
                                  (filterv #(= element-id (:to %))
                                           (vals (:connections seed)))))]
      (doseq [[id element] (:elements seed)]
        (is (= (get-in seed [:elements id :is_information_complete])
               (empty? (model/unsourced-fields element (conns-with-from id))))
            (str "element " id " (" (:name element) "): parsed "
                 (get-in seed [:elements id :is_information_complete])
                 " but its sourced fields say "
                 (empty? (model/unsourced-fields element (conns-with-from id))))))
      (is (false? (get-in seed [:elements 5 :is_information_complete]))
          "element 5's unsourced fields (no FieldOrigin, nothing carries them)")
      (is (true? (get-in seed [:elements 6 :is_information_complete]))
          "element 6's fields are all sourced (carried + derived)"))))

;; From change-stream.md's own worked examples, verbatim.
(def delta-create-element
  "{\"op\":\"CreateElement\",\"changes\":[{\"action\":\"created\",\"type\":\"element\",\"id\":5,\"entity\":{\"model\":1,\"name\":\"PlaceOrder\",\"kind\":\"command\",\"context\":\"internal\",\"fields\":[],\"field_origins\":[],\"is_information_complete\":true,\"id\":5,\"type\":\"element\"}}]}")

(def delta-set-image-url
  "{\"op\":\"SetImageUrl\",\"changes\":[{\"action\":\"updated\",\"type\":\"element\",\"id\":4,\"entity\":{\"model\":1,\"name\":\"OrderScreen\",\"kind\":\"screen\",\"context\":\"internal\",\"fields\":[{\"name\":\"id\",\"type\":\"uuid\",\"optional\":false,\"cardinality\":\"single\",\"subfields\":[]}],\"field_origins\":[],\"is_information_complete\":true,\"image_url\":\"http://x/s.png\",\"id\":4,\"type\":\"element\"}}]}")

(def delta-cascading-delete-timeline
  "{\"op\":\"DeleteTimeline\",\"changes\":[{\"action\":\"deleted\",\"type\":\"placement\",\"id\":7},{\"action\":\"deleted\",\"type\":\"spec-step\",\"id\":10},{\"action\":\"deleted\",\"type\":\"spec-step\",\"id\":11},{\"action\":\"deleted\",\"type\":\"specification\",\"id\":9},{\"action\":\"deleted\",\"type\":\"slice\",\"id\":4},{\"action\":\"deleted\",\"type\":\"timeline\",\"id\":3}]}")

(deftest normalize-create-element-delta-test
  (let [changes (stream/normalize-changes delta-create-element)]
    (is (= 1 (count changes)))
    (is (= {:entity :element :change :created
            :data {:id 5 :name "PlaceOrder" :kind :command :context :internal
                   :is_information_complete true :fields [] :field_origins []
                   :swimlane nil :image_url nil :wireframe nil}}
           (first changes)))))

(deftest normalize-updated-element-delta-test
  (let [changes (stream/normalize-changes delta-set-image-url)]
    (is (= :updated (:change (first changes))))
    (is (= "http://x/s.png" (get-in (first changes) [:data :image_url])))
    (is (= :screen (get-in (first changes) [:data :kind])))))

(deftest normalize-cascading-delete-test
  (testing "one delta, many changes, applied in leaves-first order -- every
            change normalizes even though deleted changes carry only an id"
    (let [changes (stream/normalize-changes delta-cascading-delete-timeline)]
      (is (= 6 (count changes)))
      (is (= [:placement :spec-step :spec-step :specification :slice :timeline]
             (mapv :entity changes)))
      (is (every? #(= :deleted (:change %)) changes))
      (is (every? #(= 1 (count (:data %))) changes) "delete changes carry only :id"))))

(deftest connection-update-is-derivations-not-changed-test
  (testing "SetConnectionDerivations is the only op that updates (not
            creates/deletes) a connection, so type=connection+action=updated
            unambiguously means ConnectionDerivationsRerenders"
    (let [raw "{\"op\":\"SetConnectionDerivations\",\"changes\":[{\"action\":\"updated\",\"type\":\"connection\",\"id\":12,\"entity\":{\"model\":1,\"from\":8,\"to\":9,\"derivations\":[{\"target_field\":\"total\",\"source_fields\":[\"amount\"]}],\"id\":12,\"type\":\"connection\"}}]}"
          changes (stream/normalize-changes raw)]
      (is (= :connection-derivations (:entity (first changes))))
      (is (= 8 (get-in (first changes) [:data :from])))))
  (testing "Connect/Disconnect (created/deleted) stay plain :connection"
    (let [raw "{\"op\":\"Connect\",\"changes\":[{\"action\":\"created\",\"type\":\"connection\",\"id\":12,\"entity\":{\"model\":1,\"from\":8,\"to\":9,\"derivations\":[],\"id\":12,\"type\":\"connection\"}}]}"
          changes (stream/normalize-changes raw)]
      (is (= :connection (:entity (first changes)))))))

(deftest normalize-changes-invalid-payload-test
  (is (nil? (stream/normalize-changes "not json at all")))
  (is (nil? (stream/normalize-changes "{\"op\":\"Whatever\"}")) "no changes[] at all"))

;; AddWireframeNode delta: screen element with a nested wireframe tree.
;;
;; Wire shape: [tag-str, id-map, attrs-map?, ...children]. The node's own id
;; always travels in the SECOND slot, in a map of its own, and the content
;; attributes, when the node has any, follow in a SEPARATE map -- they are
;; never merged into the id map. The root is always "canvas" (the tree IS the
;; wireframe). See ../thecli/docs/change-stream.schema.json
;; ($defs/WireframeNode) and ../thecli/doc/wireframe-dsl.md.
;;
;; The subtree below is emcli's own output, not a hand-written guess: it is
;; built with emcli's node builders and serialized by the same JSON writer the
;; SSE server uses (`emcli.wireframe/validate` accepts the result). To
;; regenerate it, verbatim:
;;
;;   cd ../thecli && bb -e '(require (quote [emcli.wireframe :as w])
;;     (quote [cheshire.core :as json]))
;;     (println (json/generate-string
;;       (-> [:canvas {:-id "n1"}]
;;           (w/append-child-at "n1" [:col])
;;           (w/assoc-attr-at "n2" :gap :md)
;;           (w/append-child-at "n2" [:h1])
;;           (w/set-text-child-at "n3" "Your orders")
;;           (w/append-child-at "n2" [:input])
;;           (w/assoc-attr-at "n4" :placeholder "Search...")
;;           (w/assoc-attr-at "n4" :field-name "orderId")
;;           (w/assoc-attr-at "n4" :command-input true))))'
;;
;; The four slot combinations the normalizer has to tell apart are all in
;; here: a root with no attrs map, a container whose attrs map sits before its
;; children, a text-children node whose string follows the id map, and a leaf
;; whose attrs map is its last element.
(def delta-add-wireframe
  (str "{\"op\":\"AddWireframeNode\",\"changes\":[{\"action\":\"updated\","
       "\"type\":\"element\",\"id\":4,\"entity\":{\"model\":1,\"name\":\"OrderScreen\","
       "\"kind\":\"screen\",\"context\":\"internal\","
       "\"fields\":[{\"name\":\"orderId\",\"type\":\"uuid\",\"optional\":false,"
       "\"cardinality\":\"single\",\"subfields\":[]}],"
       "\"wireframe\":[\"canvas\",{\"-id\":\"n1\"},"
       "[\"col\",{\"-id\":\"n2\"},{\"gap\":\"md\"},"
       "[\"h1\",{\"-id\":\"n3\"},\"Your orders\"],"
       "[\"input\",{\"-id\":\"n4\"},{\"placeholder\":\"Search...\","
       "\"field-name\":\"orderId\",\"command-input\":true}]]],"
       "\"id\":4,\"type\":\"element\"}}]}"))

(deftest normalize-wireframe-delta-test
  (let [changes (stream/normalize-changes delta-add-wireframe)
        wf (get-in changes [0 :data :wireframe])]
    (testing "root tag is :canvas -- the wire DSL's root, not :screen"
      (is (= :canvas (:tag wf))))
    (testing "the root's id map is not an attrs map: -id is dropped, not
              merged, and the root has no attrs of its own"
      (is (= {} (:attrs wf))))
    (testing "the col is the root's only child -- the id map is not a node"
      (is (= [:col] (mapv :tag (:children wf)))))
    (testing "a container's attrs map sits between the id map and its
              children, which stay children"
      (let [col (get-in wf [:children 0])]
        (is (= {:gap "md"} (:attrs col)))
        (is (nil? (get-in col [:attrs :-id])))
        (is (= [:h1 :input] (mapv :tag (:children col))))))
    (testing "h1 nested under col, with string text child (a string in the
              attrs slot is a child, never an attrs map)"
      (is (= :h1 (get-in wf [:children 0 :children 0 :tag])))
      (is (= {} (get-in wf [:children 0 :children 0 :attrs])))
      (is (= "Your orders" (get-in wf [:children 0 :children 0 :children 0]))))
    (testing "input attrs read from their own map after the id map; -id never
              leaks in, and the attrs map is not one of the children"
      (let [inp (get-in wf [:children 0 :children 1])]
        (is (= :input (:tag inp)))
        (is (= [] (:children inp)))
        (is (nil? (get-in inp [:attrs :-id])))
        (is (= "Search..." (get-in inp [:attrs :placeholder])))
        (is (= "orderId" (get-in inp [:attrs :field-name])))
        (is (true? (get-in inp [:attrs :command-input])))))
    (testing "wireframe is nil when field is absent"
      (is (nil? (get-in (first (stream/normalize-changes delta-create-element))
                        [:data :wireframe]))))))

;; Snapshot with a wireframe on a placed screen element. The root is the wire
;; DSL's "canvas" tag, and the h1's {"-id"} is its own second slot, with the
;; text following directly (no attrs map on that node).
;;
;; It deliberately carries no `elements` registry, i.e. the shape a snapshot from
;; an emcli predating the registry has, and a connection whose `to` end (element
;; 7) is in no placement: that is what makes it the fixture for the projection
;; gap-fillers -- the placement walk supplies element 5, the connection walk
;; supplies element 7 as a bare {id, name} reference.
(def snapshot-with-wireframe
  (str "{\"op\":\"snapshot\",\"model\":{\"id\":1,\"name\":\"m\","
       "\"timelines\":[{\"id\":2,\"title\":\"T\","
       "\"slices\":[{\"id\":3,\"title\":\"S\",\"kind\":\"state_change\","
       "\"status\":\"created\",\"index\":0,"
       "\"placements\":[{\"id\":4,"
       "\"element\":{\"id\":5,\"name\":\"OrderScreen\",\"kind\":\"screen\","
       "\"is_information_complete\":true,"
       "\"fields\":[],"
       "\"wireframe\":[\"canvas\",{\"-id\":\"n1\"},"
       "[\"h1\",{\"-id\":\"n2\"},\"Hello\"]]}}],"
       "\"specifications\":[]}]}],"
       "\"swimlanes\":[],"
       "\"connections\":[{\"id\":6,\"from\":{\"id\":5,\"name\":\"OrderScreen\"},"
       "\"to\":{\"id\":7,\"name\":\"OrderPlaced\"},\"derivations\":[]}]}}"))

(deftest normalize-snapshot-wireframe-test
  (let [seed (stream/normalize-snapshot snapshot-with-wireframe)
        wf (get-in seed [:elements 5 :wireframe])]
    (testing "wireframe present on snapshot-embedded screen element"
      (is (= :canvas (:tag wf))))
    (testing "h1 text child intact through snapshot normalization"
      (is (= :h1 (get-in wf [:children 0 :tag])))
      (is (= "Hello" (get-in wf [:children 0 :children 0]))))
    (testing "this fixture deliberately carries no `elements` registry, i.e. the
              shape a snapshot from an emcli predating it has: the placement's own
              projection is then the only element record, and registering it is
              what keeps such a snapshot usable. It carries a kind, so the card is
              drawn as a card (em-frontend.store/element-loaded?)"
      (is (some? (get-in seed [:elements 5 :kind]))))))

(deftest normalize-registry-less-snapshot-fills-elements-from-its-projections-test
  (testing "with no registry to seed from, the projection walks fill the element
            index by id -- a gap only, so the walk that supplies the fuller
            record cannot be overwritten by one that supplies less"
    (let [seed (stream/normalize-snapshot snapshot-with-wireframe)]
      (is (= :screen (get-in seed [:elements 5 :kind]))
          "element 5 came from the placement's projection, and the connection that
           also names it did not displace that record")
      (testing "element 7 appears only as a connection endpoint's {id, name}, so it
                is registered without a kind -- not a record the canvas presents as
                an element"
        (is (= "OrderPlaced" (get-in seed [:elements 7 :name])))
        (is (nil? (get-in seed [:elements 7 :kind])))
        (is (not (store/element-loaded? (get-in seed [:elements 7]))))))))

(deftest normalize-snapshot-seeds-an-element-no-projection-reaches-test
  (testing "the grey-box report's case, at the seed: element 10 is in no placement
            and no connection, so the snapshot's nested projections say nothing
            about it. The registry is the only reason the frontend has a record
            for it -- and a later PlaceElement delta names it by id alone, so
            without the registry the store would hold a placement it could never
            resolve"
    (let [seed (stream/normalize-snapshot real-snapshot)]
      (is (= "OrderCancelled" (get-in seed [:elements 10 :name])))
      (is (= :event (get-in seed [:elements 10 :kind])))
      (is (not-any? #(= 10 (:element %)) (vals (:placements seed)))
          "no placement reaches it")
      (is (not-any? #(or (= 10 (:from %)) (= 10 (:to %))) (vals (:connections seed)))
          "no connection reaches it")
      (testing "and placing it resolves against that seed, so the card is a card"
        (let [store (:store (store/snapshot-received (store/initial-store) seed))
              {:keys [store]} (store/apply-delta store {:entity :placement :change :created
                                                        :data {:id 99 :slice 4 :element 10}})]
          (is (= 10 (get-in store [:placements 99 :element])))
          (is (store/element-loaded? (get-in store [:elements 10]))))))))

;; == Driver lifecycle =========================================================
;; The connection itself (http/Client, Completer, StreamSubscription,
;; Future/delayed) is outside what cljd.test can reach: it needs a live
;; socket and an async seam, so it stays an accepted gap. What IS reachable is
;; the policy the loop runs -- `retry-decision`, extracted from
;; `drive-stream!` for exactly this reason -- and `disconnect!`'s contract
;; against a fabricated handle.

(deftest disconnect-contract-test
  (testing "nil is a no-op (a caller need not track whether the driver is live)"
    (is (nil? (stream/disconnect! nil))))
  (testing "a handle's :cancel fn is invoked, exactly once"
    (let [calls (atom 0)]
      (stream/disconnect! {:cancel (fn [] (swap! calls inc))})
      (is (= 1 @calls)))))

(deftest retry-decision-policy-test
  (testing "the first failed attempt retries as attempt 1 after the initial backoff"
    (is (= {:attempt 1 :delay-ms 500} (stream/retry-decision 0 false))))
  (testing "the delay doubles per attempt, then caps at max-backoff-ms
            (backoff-ms(a) = min(30000, 500 * 2^a), so attempt 6 is capped)"
    (is (= [1000 2000 4000 8000 16000 30000]
           (mapv #(:delay-ms (stream/retry-decision % false)) (range 1 7)))))
  (testing "reaching :connected resets the count to 0, whatever the attempt
            number -- so :error is never merely cumulative"
    (is (= {:attempt 1 :delay-ms 500} (stream/retry-decision 5 true)))
    (is (= {:attempt 1 :delay-ms 500} (stream/retry-decision 3 true))))
  (testing "attempt 7 exhausts max-attempts: :error, never another retry"
    (is (= {:state :error} (stream/retry-decision 7 false))))
  (testing "the cap holds: no :delay-ms ever exceeds max-backoff-ms"
    (is (every? #(<= (:delay-ms %) 30000)
                (keep #(when-not (:state %) %) (map #(stream/retry-decision % false)
                                                    (range 0 8)))))))
